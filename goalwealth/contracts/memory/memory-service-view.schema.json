{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goalwealth.local/contracts/memory-service-view.schema.json",
  "title": "GoalWealth Memory Service View",
  "description": "Structured view of user memory state for OpenClaw orchestrator consumption. This view exposes user profile, goals, OCR summaries, risk constraints, and conversation summaries from the external structured memory backend.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "user_id",
    "user_profile",
    "goals",
    "risk_profile",
    "ocr_summaries",
    "conversation_summary",
    "last_updated"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "user_profile": {
      "$ref": "#/$defs/userProfile"
    },
    "goals": {
      "$ref": "#/$defs/goals"
    },
    "risk_profile": {
      "$ref": "#/$defs/riskProfile"
    },
    "ocr_summaries": {
      "$ref": "#/$defs/ocrSummaries"
    },
    "conversation_summary": {
      "$ref": "#/$defs/conversationSummary"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "userProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "full_name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "city": {
              "type": "string"
            },
            "country": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            }
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_id",
        "title",
        "type",
        "status",
        "created_at"
      ],
      "properties": {
        "goal_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "savings_goal",
            "debt_payoff_goal",
            "investment_goal",
            "retirement_goal",
            "emergency_fund_goal",
            "wealth_building_goal"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "completed",
            "paused",
            "archived"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "target_amount": {
          "type": "number",
          "minimum": 0
        },
        "current_progress": {
          "type": "number",
          "minimum": 0
        },
        "target_date": {
          "type": "string",
          "format": "date"
        },
        "description": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "milestone_id",
              "title",
              "target_amount",
              "target_date"
            ],
            "properties": {
              "milestone_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "target_amount": {
                "type": "number",
                "minimum": 0
              },
              "current_progress": {
                "type": "number",
                "minimum": 0
              },
              "target_date": {
                "type": "string",
                "format": "date"
              },
              "completed_at": {
                "type": "string",
                "format": "date-time"
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "goals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_active_goals",
        "total_goals",
        "active_goals"
      ],
      "properties": {
        "total_active_goals": {
          "type": "integer",
          "minimum": 0
        },
        "total_goals": {
          "type": "integer",
          "minimum": 0
        },
        "active_goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goal"
          }
        },
        "completed_goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goal"
          }
        },
        "paused_goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goal"
          }
        },
        "archived_goals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/goal"
          }
        }
      }
    },
    "riskProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "risk_tolerance": {
          "type": "string",
          "enum": [
            "conservative",
            "moderate",
            "balanced",
            "growth",
            "aggressive"
          ]
        },
        "calculated_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "investment_horizon": {
          "type": "string",
          "enum": [
            "short_term",
            "medium_term",
            "long_term"
          ]
        },
        "knowledge_level": {
          "type": "string",
          "enum": [
            "beginner",
            "intermediate",
            "advanced",
            "expert"
          ]
        },
        "liquidity_needs": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_loss": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "min_return": {
              "type": "number",
              "minimum": -100,
              "maximum": 100
            },
            "sector_exclusions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "asset_class_limits": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "ocrSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ocr_record_id",
        "document_type",
        "summary_text",
        "created_at"
      ],
      "properties": {
        "ocr_record_id": {
          "type": "string",
          "minLength": 1
        },
        "document_type": {
          "type": "string",
          "enum": [
            "receipt",
            "bank_statement",
            "salary_slip",
            "investment_statement",
            "insurance_document",
            "unknown"
          ]
        },
        "summary_text": {
          "type": "string",
          "minLength": 1
        },
        "usable": {
          "type": "boolean"
        },
        "overall_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "document_date": {
          "type": "string",
          "format": "date"
        },
        "amount_involved": {
          "type": "number"
        },
        "institution_name": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "related_goal_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ocrSummaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_summaries",
        "recent_summaries"
      ],
      "properties": {
        "total_summaries": {
          "type": "integer",
          "minimum": 0
        },
        "recent_summaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ocrSummary"
          },
          "maxItems": 10
        },
        "by_type": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "conversationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_turn_date",
        "total_turns",
        "last_topic",
        "user_intent"
      ],
      "properties": {
        "last_turn_date": {
          "type": "string",
          "format": "date-time"
        },
        "total_turns": {
          "type": "integer",
          "minimum": 0
        },
        "last_topic": {
          "type": "string"
        },
        "user_intent": {
          "type": "string"
        },
        "last_message": {
          "type": "string"
        },
        "context_needs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pending_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action_type",
              "target"
            ],
            "properties": {
              "action_type": {
                "type": "string",
                "enum": [
                  "update_goal",
                  "review_document",
                  "check_balance",
                  "analyze_portfolio",
                  "recommend_action"
                ]
              },
              "target": {
                "type": "string"
              },
              "priority": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "field_path": {
          "type": "string"
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "severity"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "field_path": {
          "type": "string"
        }
      }
    }
  }
}
