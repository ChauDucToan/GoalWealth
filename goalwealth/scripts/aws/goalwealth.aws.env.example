# Copy to a real file, e.g. goalwealth.aws.env, then edit values.

# --- AWS / stack ---
export AWS_REGION="ap-northeast-1"
export GW_ENV="dev"
export GW_STACK_NAME="goalwealth-dev"
export GW_ARTIFACT_BUCKET="your-s3-artifact-bucket"

# Whether to deploy/update the SAM stack before EC2 bootstrapping.
export GW_DEPLOY_SAM="true"

# --- EC2 runtime ---
export GW_RUNTIME_NAME="goalwealth-runtime-dev"
export GW_SUBNET_ID="subnet-xxxxxxxx"
export GW_SG_ID="sg-xxxxxxxx"
export GW_KEY_NAME="your-ec2-keypair-name"
export GW_SSH_KEY_PATH="/absolute/path/to/your-key.pem"
export GW_INSTANCE_PROFILE="YourEc2InstanceProfile"
export GW_INSTANCE_TYPE="t4g.medium"
export GW_EC2_USER="ec2-user"

# If non-empty, the deploy script reuses an existing EC2 instance instead of launching a new one.
export GW_EXISTING_INSTANCE_ID=""

# --- GoalWealth auth/runtime ---
export GW_INTERNAL_BEARER_TOKEN="replace-me-in-aws"
export GW_ENABLE_OIDC="false"
export GW_GOOGLE_CLIENT_ID=""

# Optional if you want docs locally enabled on EC2 services.
export GW_ENABLE_DOCS="false"

# Adapter exposure port. Security Group should allow this if you need public testing.
export GW_ADAPTER_PORT="8080"

# Internal stub stays loopback-only.
export GW_INTERNAL_BACKEND_PORT="8090"

# News base URL used by internal smart-agent stub payloads.
export GW_NEWS_BASE_URL="https://news.goalwealth.example.com"

# Remote app directory on EC2.
export GW_REMOTE_APP_DIR="/opt/goalwealth-workspace"

# Optional: install OpenClaw package if missing. This does NOT fully configure live GoalWealth orchestration.
export GW_INSTALL_OPENCLAW="false"

# Optional: npm install target for OpenClaw when GW_INSTALL_OPENCLAW=true
export GW_OPENCLAW_NPM_PACKAGE="openclaw"
