{
  // Example OpenClaw config for the dedicated GoalWealth production runtime.
  // Use a separate workspace from the personal assistant workspace.
  // Do NOT place MEMORY.md / memory.md / memory/*.md in that runtime workspace.

  "gateway": {
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        },
        "responses": {
          "enabled": false
        }
      }
    }
  },

  "memory": {
    "backend": "qmd",
    "qmd": {
      "includeDefaultMemory": false,
      "paths": []
    }
  },

  "agents": {
    "defaults": {
      "memorySearch": {
        "extraPaths": []
      }
    }
  }
}
