# GoalWealth public adapter base URL.
# Local adapter default port is 8080, matching goalwealth/infra/environments/goalwealth-adapter.env.example.
EXPO_PUBLIC_GOALWEALTH_API_BASE_URL=http://localhost:8080

# Enable live adapter calls for chat/OCR against the public GoalWealth adapter.
EXPO_PUBLIC_GOALWEALTH_USE_LIVE_ADAPTER=true

# Dev bridge only. Disable this for production once Google OIDC is wired.
EXPO_PUBLIC_GOALWEALTH_USE_DEV_AUTH_BRIDGE=true
EXPO_PUBLIC_ENABLE_DEV_HOME_BYPASS=false
EXPO_PUBLIC_ENABLE_LEGACY_PASSWORD_AUTH=false

# Optional legacy bridge only. Keep disabled unless you explicitly need it for local compatibility.
EXPO_PUBLIC_OAUTH_TOKEN_ENDPOINT=https://your-domain.com/oauth/token
EXPO_PUBLIC_OAUTH_CLIENT_ID=your-client-id
EXPO_PUBLIC_OAUTH_SCOPE=openid profile email
EXPO_PUBLIC_OAUTH_USERINFO_ENDPOINT=https://your-domain.com/oauth/userinfo
