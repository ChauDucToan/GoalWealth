# GoalWealth adapter -> internal services
# Set these to your real backend domain services before production.
export GOALWEALTH_INTERNAL_API_BASE_URL="https://internal-api.example.com"
export GOALWEALTH_INTERNAL_API_BEARER_TOKEN="replace-me"
export GOALWEALTH_INTERNAL_API_TIMEOUT_SECONDS="10"
export GOALWEALTH_INTERNAL_API_USER_AGENT="GoalWealthAdapter/0.1"

# GoalWealth adapter runtime
export GOALWEALTH_ADAPTER_SERVICE_NAME="goalwealth-adapter-api"
export GOALWEALTH_ADAPTER_VERSION="0.1.0"
export GOALWEALTH_ADAPTER_ENV="production"
export GOALWEALTH_ADAPTER_HOST="0.0.0.0"
export GOALWEALTH_ADAPTER_PORT="8080"
export GOALWEALTH_ADAPTER_LOG_LEVEL="INFO"
export GOALWEALTH_ADAPTER_ENABLE_DOCS="false"
export GOALWEALTH_ADAPTER_AUTH_OPTIONAL="false"
export GOALWEALTH_ADAPTER_ALLOW_DEV_TOKENS="false"

# Google OIDC verification
# Audience must match the Google client ID used by the frontend sign-in flow.
export GOALWEALTH_OIDC_ISSUER="https://accounts.google.com"
export GOALWEALTH_OIDC_AUDIENCE="595597054481-ndmo5b7oqg5lrv9qbt9ddvc4r0ilg7kp.apps.googleusercontent.com"
export GOALWEALTH_OIDC_JWKS_URL="https://www.googleapis.com/oauth2/v3/certs"
export GOALWEALTH_OIDC_TOKENINFO_URL="https://oauth2.googleapis.com/tokeninfo"
export GOALWEALTH_OIDC_TIMEOUT_SECONDS="10"

# Adapter -> OpenClaw Gateway HTTP
# Fill both values if you want live orchestration instead of placeholder responses.
export GOALWEALTH_OPENCLAW_BASE_URL="https://openclaw.example.com"
export GOALWEALTH_OPENCLAW_TOKEN="replace-me"
export GOALWEALTH_OPENCLAW_AGENT_ID="main"
export GOALWEALTH_OPENCLAW_SESSION_PREFIX="goalwealth"
export GOALWEALTH_OPENCLAW_HTTP_ENDPOINT="chat_completions"

# Optional internal API prefix override
export GOALWEALTH_INTERNAL_API_PREFIX="GOALWEALTH_INTERNAL_API_"
