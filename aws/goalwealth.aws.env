# Copy to a real file, e.g. goalwealth.aws.env, then edit values.

# --- AWS / stack ---
export AWS_REGION="ap-northeast-1"
export GW_ENV="dev"
export GW_STACK_NAME="goalwealth-dev"
export GW_ARTIFACT_BUCKET="goalwealth-artifact-dev-0001"

# Whether to deploy/update the SAM stack before EC2 bootstrapping.
export GW_DEPLOY_SAM="true"

# --- EC2 runtime ---
export GW_RUNTIME_NAME="goalwealth-runtime-dev"
export GW_SUBNET_ID="subnet-0529a38aef6fc5db4"
export GW_SG_ID="sg-0a85dfe9e99163322"
export GW_KEY_NAME="OpenClaw"
export GW_SSH_KEY_PATH="/home/oslamelon/.ssh/oracle"
export GW_INSTANCE_PROFILE="BedrockModelAccess"
export GW_INSTANCE_TYPE="t4g.medium"
export GW_EC2_USER="ubuntu"

# If non-empty, the deploy script reuses an existing EC2 instance instead of launching a new one.
export GW_EXISTING_INSTANCE_ID="i-0edf48c3af9bfaa76"

# --- GoalWealth auth/runtime ---
export GW_INTERNAL_BEARER_TOKEN="+SIUbc8IGrdYGQ3fS1mwbHnH2YcQlX7QMM/oTP/90+k="
export GW_ENABLE_OIDC="true"
export GW_GOOGLE_CLIENT_ID="595597054481-aljbcsgf48vi3gr5pkb3gni6lh8qb3k5.apps.googleusercontent.com"

# --- Optional OpenClaw orchestration wiring for adapter -> OpenClaw gateway ---
# Leave empty to keep the adapter on placeholder orchestration mode.
export GW_OPENCLAW_BASE_URL="http://127.0.0.1:18789"
export GW_OPENCLAW_TOKEN="02441d94d9011de1623547f857a6d5dd0c351eb3789f88b7"
export GW_OPENCLAW_AGENT_ID="main"
export GW_OPENCLAW_SESSION_PREFIX="goalwealth"
# Use chat_completions by default for compatibility; responses can be enabled later if desired.
export GW_OPENCLAW_HTTP_ENDPOINT="chat_completions"

# --- Optional PostgreSQL / RDS wiring ---
# Assume the database already exists. Leave empty to keep persistence disabled.
export GW_DATABASE_URL="postgresql://postgres:postgres@goalwealth-instance-1.chgk0yq4owe7.ap-northeast-1.rds.amazonaws.com:5432/postgres"
# Apply the draft DDL automatically during remote bootstrap when GW_DATABASE_URL is set.
export GW_APPLY_DDL_V1="true"
# Optional SQLAlchemy engine echo.
export GW_DATABASE_ECHO_SQL="false"

# Optional if you want docs locally enabled on EC2 services.
export GW_ENABLE_DOCS="false"

# Adapter exposure port. Security Group should allow this if you need public testing.
export GW_ADAPTER_PORT="8080"

# Internal stub stays loopback-only.
export GW_INTERNAL_BACKEND_PORT="8090"

# News base URL used by internal smart-agent stub payloads.
export GW_NEWS_BASE_URL="https://news.goalwealth.example.com"

# Remote app directory on EC2.
export GW_REMOTE_APP_DIR="/opt/goalwealth-workspace"

# Optional: install OpenClaw package if missing. This does NOT fully configure live GoalWealth orchestration.
export GW_INSTALL_OPENCLAW="false"

# Optional: npm install target for OpenClaw when GW_INSTALL_OPENCLAW=true
export GW_OPENCLAW_NPM_PACKAGE="openclaw"
